{
  "schemaVersion": 1,
  "id": "wexside-visuals",
  "version": "${version}",
  "name": "WexVisuals",
  "description": "Visual mod with trails, hats, jump particles, player models and hitbox colors",
  "authors": ["WexVisuals"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/wexside/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.wexside.visuals.client.WexVisualsClient"
    ]
  },
  "mixins": [
    "wexside-visuals.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  }
}
